<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editors="using:ZHSan.Editor.Desktop.Editors"
             xmlns:views="using:ZHSan.Editor.Desktop.Views"
             x:Class="ZHSan.Editor.Desktop.Views.ArchitectureEditorView"
             x:DataType="editors:ArchitectureEditorViewModel">
  <UserControl.Styles>
    <Style Selector="NumericUpDown.compact">
      <Setter Property="ShowButtonSpinner" Value="False" />
      <Setter Property="Increment" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
      <Setter Property="views:IntegerInput.IsEnabled" Value="True" />
    </Style>
    <Style Selector="NumericUpDown.invalid-input">
      <Setter Property="BorderBrush" Value="#E5534B" />
      <Setter Property="ToolTip.Tip" Value="只能输入整数，离开输入框后会恢复原值" />
    </Style>
    <!-- Same grid as the person editor: 268px cells, 64px right-aligned label, 8px gap, 180px input. -->
    <Style Selector="TextBlock.field-label">
      <Setter Property="Width" Value="64" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="TextBlock.warning">
      <Setter Property="Foreground" Value="#E5534B" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="14" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="#30343D" />
      <Setter Property="BorderBrush" Value="#59606C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,2,2,2" />
    </Style>
    <Style Selector="Button.chip-remove">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="24" />
    </Style>
  </UserControl.Styles>
  <UserControl.DataTemplates>
    <DataTemplate x:DataType="editors:PersonFieldGroupViewModel">
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="12" Opacity="0.65"
                       VerticalAlignment="Center" Classes.warning="{Binding IsWarning}" TextWrapping="Wrap" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Fields}" Margin="0,0,0,-10">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemWidth="268" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="editors:PersonBasicFieldViewModel">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Spacing="8">
                  <TextBlock Text="{Binding Label}" Classes="field-label" />
                  <Panel Width="{Binding InputWidth}">
                    <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             IsVisible="{Binding IsText}" />
                    <NumericUpDown Value="{Binding NumericValue, Mode=TwoWay}"
                                   Classes="compact" IsVisible="{Binding IsNumber}" />
                    <ComboBox ItemsSource="{Binding ChoiceOptions}"
                              SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                              IsVisible="{Binding IsChoice}" HorizontalAlignment="Stretch">
                      <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                      </ComboBox.ItemsPanel>
                    </ComboBox>
                    <CheckBox IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                              IsVisible="{Binding IsBoolean}" />
                  </Panel>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:DataType="editors:PersonIdChipListViewModel">
      <Grid ColumnDefinitions="64,*" ColumnSpacing="8">
        <TextBlock Text="{Binding Label}" Classes="field-label" VerticalAlignment="Top" Margin="0,6,0,0" />
        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock Text="{Binding Hint}" IsVisible="{Binding HasHint}" TextWrapping="Wrap"
                     FontSize="12" Opacity="0.6" Margin="0,6,0,0" />
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="editors:PersonIdChipViewModel">
                <Border Classes="chip" Margin="0,0,6,6">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                    <Button Classes="chip-remove" Content="×" Command="{Binding RemoveCommand}" ToolTip.Tip="移除"
                            IsVisible="{Binding CanRemove}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="（空）" Opacity="0.5" FontSize="12" IsVisible="{Binding IsEmpty}" />
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsReadOnly}">
            <AutoCompleteBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding Candidate, Mode=TwoWay}"
                             Text="{Binding CandidateText, Mode=TwoWay}" FilterMode="Contains" MinimumPrefixLength="1" MaxDropDownHeight="320"
                             PlaceholderText="{Binding Placeholder}" IsEnabled="{Binding CanEdit}" Width="320" />
            <Button Content="添加" Command="{Binding AddCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Foreground="#D9534F"
                     IsVisible="{Binding !CanEdit}" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>
  <Grid ColumnDefinitions="220,1,*" Background="#08000000">
    <Grid RowDefinitions="Auto,Auto,*" Margin="10">
      <TextBlock Text="建筑" FontSize="18" FontWeight="SemiBold" Margin="5,4,0,8" />
      <TextBox Grid.Row="1" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="搜索名称或 ID" Margin="0,0,0,6" />
      <ListBox Grid.Row="2" ItemsSource="{Binding FilteredRecords}"
               SelectedItem="{Binding SelectedRecord, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="editors:RecordOptionViewModel">
            <TextBlock Text="{Binding Label}" Margin="5,4" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <Border Grid.Column="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    <Grid Grid.Column="2" RowDefinitions="Auto,*">
      <Border Padding="17,11" BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding SelectedTitle}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SelectedId}" Opacity="0.58" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding CountText}" Opacity="0.58" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1">
        <StackPanel Margin="16" Spacing="13">
          <TextBlock Text="选择左侧建筑，编辑属性。修改会进入撤销记录，使用主窗口的保存按钮写入文件。建筑归属哪个势力在“势力”中编辑。" TextWrapping="Wrap" Opacity="0.6" FontSize="12" />
          <TextBlock Text="当前没有记录。" IsVisible="{Binding !HasSelection}" />
          <ContentControl Content="{Binding BasicGroup}" IsVisible="{Binding HasSelection}" />
          <Border Classes="card" IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="8">
              <TextBlock Text="归属" FontSize="16" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="所属势力" Classes="field-label" />
                <TextBlock Text="{Binding FactionText}" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="所属地区" Classes="field-label" />
                <TextBlock Text="{Binding RegionText}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="只读：势力的领有建筑在“势力”中编辑，地区由所属州决定。"
                         TextWrapping="Wrap" FontSize="12" Opacity="0.55" />
            </StackPanel>
          </Border>
          <ContentControl Content="{Binding InteriorGroup}" IsVisible="{Binding HasSelection}" />
          <Border Classes="card" IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="10">
              <TextBlock Text="特色与设施" FontSize="16" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding FeatureLists}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="12" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="10">
              <TextBlock Text="人物" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="每个人物只能在一座建筑的一个列表中，添加时会自动从原所在处移出。"
                         TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
              <ItemsControl ItemsSource="{Binding PeopleLists}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="12" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="10">
              <TextBlock Text="AI 路线" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{Binding LinkStatus}" TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
              <ItemsControl ItemsSource="{Binding LinkLists}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="12" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
          </Border>
          <ContentControl Content="{Binding MapGroup}" IsVisible="{Binding HasSelection}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
