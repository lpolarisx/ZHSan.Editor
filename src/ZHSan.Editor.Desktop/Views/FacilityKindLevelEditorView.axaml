<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editors="using:ZHSan.Editor.Desktop.Editors"
             xmlns:views="using:ZHSan.Editor.Desktop.Views"
             x:Class="ZHSan.Editor.Desktop.Views.FacilityKindLevelEditorView"
             x:DataType="editors:FacilityKindLevelEditorViewModel">
  <UserControl.Styles>
    <Style Selector="NumericUpDown.compact">
      <Setter Property="ShowButtonSpinner" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style Selector="NumericUpDown.integer">
      <Setter Property="Increment" Value="1" />
      <Setter Property="views:IntegerInput.IsEnabled" Value="True" />
    </Style>
    <Style Selector="NumericUpDown.invalid-input">
      <Setter Property="BorderBrush" Value="#E5534B" />
      <Setter Property="ToolTip.Tip" Value="只能输入整数，离开输入框后会恢复原值" />
    </Style>
    <!-- Same cells as the table editors: 280px cell, 76px right-aligned label, 8px gap, 100px or 180px input. -->
    <Style Selector="StackPanel.cell">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="8" />
      <Setter Property="Width" Value="280" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="Width" Value="76" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="14" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" Background="#08000000">
    <Border Padding="12,9" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Opacity="0.72" />
        <TextBlock Grid.Column="1" Text="{Binding Summary}" VerticalAlignment="Center"
                   FontWeight="SemiBold" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="220,1,260,1,*">
      <Grid RowDefinitions="Auto,*">
        <StackPanel Margin="14,14,14,8" Spacing="3">
          <TextBlock Text="设施种类" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="选择种类以查看其全部等级" FontSize="11" Opacity="0.58" />
        </StackPanel>
        <ListBox Grid.Row="1" Margin="8,0,8,12"
                 ItemsSource="{Binding KindOptions}"
                 SelectedItem="{Binding SelectedKind, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="editors:FacilityKindOptionViewModel">
              <Grid ColumnDefinitions="*,Auto" Margin="4,5">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="1" CornerRadius="8" Padding="7,1" Background="#223B82F6">
                  <TextBlock Text="{Binding CountLabel}" FontSize="11" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Border Grid.Column="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

      <Grid Grid.Column="2" RowDefinitions="Auto,*">
        <Grid Margin="14,12" ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="等级配置" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="按等级顺序展示；红色提示表示组合重复、断档或引用无效"
                       FontSize="11" Opacity="0.58" />
          </StackPanel>
          <Button Grid.Column="1" Content="新增下一级" Command="{Binding AddLevelCommand}"
                  VerticalAlignment="Center" />
        </Grid>

        <ListBox Grid.Row="1" Margin="10,0,10,12"
                 ItemsSource="{Binding Levels}"
                 SelectedItem="{Binding SelectedLevel, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="editors:FacilityLevelViewModel">
              <Border Padding="12,10" Margin="3" CornerRadius="6" BorderThickness="1"
                      BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                      ToolTip.Tip="{Binding ToolTip}">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="⚠" Foreground="#E5484D" IsVisible="{Binding HasIssues}" />
                    <TextBlock Text="{Binding Id, StringFormat='记录 #{0}'}" FontSize="11" Opacity="0.58" />
                  </StackPanel>
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding CostSummary}"
                             Margin="0,5,0,0" />
                  <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding BuildSummary}"
                             Margin="0,3,0,0" FontSize="11" Opacity="0.65" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Border Grid.Column="3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

      <ScrollViewer Grid.Column="4">
        <StackPanel Margin="14" Spacing="12">
          <TextBlock Text="等级属性" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="请选择一条等级配置。" Opacity="0.62"
                     IsVisible="{Binding !HasLevelSelection}" />

          <StackPanel Spacing="12" IsVisible="{Binding HasLevelSelection}">
            <Border Classes="card">
              <StackPanel Spacing="10">
                <WrapPanel Margin="0,0,0,-10">
                  <StackPanel Classes="cell">
                    <TextBlock Text="记录 ID" Classes="field-label" />
                    <TextBox Text="{Binding SelectedId}" IsReadOnly="True" Width="100" />
                  </StackPanel>
                  <StackPanel Classes="cell">
                    <TextBlock Text="设施种类" Classes="field-label" />
                    <ComboBox ItemsSource="{Binding KindOptions}" Width="180"
                              SelectedItem="{Binding SelectedKindForLevel, Mode=TwoWay}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="editors:FacilityKindOptionViewModel">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Classes="cell">
                    <TextBlock Text="等级" Classes="field-label" />
                    <NumericUpDown Value="{Binding SelectedLevelNumber, Mode=TwoWay}" Classes="compact integer" Width="100"
                                   Minimum="1" Maximum="2147483647" />
                  </StackPanel>                  <StackPanel Classes="cell">
                    <TextBlock Text="占地" Classes="field-label" />
                    <NumericUpDown Value="{Binding SelectedPositionOccupied, Mode=TwoWay}" Classes="compact integer" Width="100"
                                   Minimum="0" Maximum="2147483647" />
                  </StackPanel>                  <StackPanel Classes="cell">
                    <TextBlock Text="耐久" Classes="field-label" />
                    <NumericUpDown Value="{Binding SelectedEndurance, Mode=TwoWay}" Classes="compact integer" Width="100"
                                   Minimum="0" Maximum="2147483647" />
                  </StackPanel>                  <StackPanel Classes="cell">
                    <TextBlock Text="点数成本" Classes="field-label" />
                    <NumericUpDown Value="{Binding SelectedPointCost, Mode=TwoWay}" Classes="compact integer" Width="100"
                                   Minimum="0" Maximum="2147483647" />
                  </StackPanel>                  <StackPanel Classes="cell">
                    <TextBlock Text="资金成本" Classes="field-label" />
                    <NumericUpDown Value="{Binding SelectedFundCost, Mode=TwoWay}" Classes="compact integer" Width="100"
                                   Minimum="0" Maximum="2147483647" />
                  </StackPanel>                  <StackPanel Classes="cell">
                    <TextBlock Text="维护成本" Classes="field-label" />
                    <NumericUpDown Value="{Binding SelectedMaintenanceCost, Mode=TwoWay}" Classes="compact integer" Width="100"
                                   Minimum="0" Maximum="2147483647" />
                  </StackPanel>                  <StackPanel Classes="cell">
                    <TextBlock Text="建设天数" Classes="field-label" />
                    <NumericUpDown Value="{Binding SelectedDays, Mode=TwoWay}" Classes="compact integer" Width="100"
                                   Minimum="0" Maximum="2147483647" />
                  </StackPanel>                  <StackPanel Classes="cell" ToolTip.Tip="所在建筑的技术值达到此数才能兴建">
                    <TextBlock Text="所需技术" Classes="field-label" />
                    <NumericUpDown Value="{Binding SelectedTechnologyNeeded, Mode=TwoWay}" Classes="compact integer" Width="100"
                                   Minimum="0" Maximum="2147483647" />
                  </StackPanel>                  <StackPanel Classes="cell">
                    <TextBlock Text="容纳妃子数" Classes="field-label" />
                    <NumericUpDown Value="{Binding SelectedConcubineCapacity, Mode=TwoWay}" Classes="compact integer" Width="100"
                                   Minimum="0" Maximum="2147483647" />
                  </StackPanel>                </WrapPanel>

                <Border Padding="10" CornerRadius="5" Background="#12FFFFFF">
                  <TextBlock Text="{Binding SelectedIssueSummary}" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding Influences.Label}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Influences.Hint}" TextWrapping="Wrap" FontSize="12" Opacity="0.6" />
                <ContentControl Content="{Binding Influences.Editor}" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding Conditions.Label}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Conditions.Hint}" TextWrapping="Wrap" FontSize="12" Opacity="0.6" />
                <ContentControl Content="{Binding Conditions.Editor}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
