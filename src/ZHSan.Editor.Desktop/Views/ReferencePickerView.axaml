<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZHSan.Editor.Desktop.ViewModels"
             x:Class="ZHSan.Editor.Desktop.Views.ReferencePickerView"
             x:DataType="vm:ReferencePickerViewModel">
  <StackPanel Spacing="5">
    <Grid ColumnDefinitions="*,6,Auto">
      <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="按名称或 ID 筛选…" />
      <Button Grid.Column="2" Content="清除" Command="{Binding ClearSearchCommand}" />
    </Grid>
    <Grid ColumnDefinitions="*,6,Auto">
      <ComboBox ItemsSource="{Binding FilteredOptions}"
                SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                PlaceholderText="没有匹配的引用目标">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ReferenceOptionViewModel">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="2" Content="定位" Command="{Binding NavigateCommand}" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="当前引用无效或目标 ID 重复" Foreground="#E5484D" FontSize="11"
                 IsVisible="{Binding HasMissingSelection}" />
      <TextBlock Grid.Column="1" Text="{Binding ResultSummary}" FontSize="11" Opacity="0.55" />
    </Grid>
  </StackPanel>
</UserControl>
