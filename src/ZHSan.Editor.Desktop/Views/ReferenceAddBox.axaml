<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZHSan.Editor.Desktop.ViewModels"
             x:Class="ZHSan.Editor.Desktop.Views.ReferenceAddBox"
             x:DataType="vm:ReferencePickerViewModel">
  <UserControl.Styles>
    <Style Selector="Grid.added">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <TextBox x:Name="SearchBox"
             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             PlaceholderText="{Binding Placeholder}" />
    <Popup x:Name="SuggestionPopup" PlacementTarget="{Binding #SearchBox}" Placement="BottomEdgeAlignedLeft"
           IsLightDismissEnabled="True" MinWidth="{Binding #SearchBox.Bounds.Width}">
      <Border Background="{DynamicResource ComboBoxDropDownBackground}"
              BorderBrush="{DynamicResource ComboBoxDropDownBorderBrush}"
              BorderThickness="1" CornerRadius="4" Padding="2"
              MaxWidth="{Binding #SearchBox.Bounds.Width}">
        <StackPanel Spacing="2">
          <ListBox x:Name="SuggestionList" ItemsSource="{Binding Suggestions}" MaxHeight="320"
                   IsVisible="{Binding HasSuggestions}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ReferenceSuggestionViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" Classes.added="{Binding IsAdded}"
                      ToolTip.Tip="{Binding Description}">
                  <TextBlock Text="{Binding Label}" />
                  <TextBlock Grid.Column="1" Text="{Binding Description, StringFormat='　{0}'}"
                             IsVisible="{Binding HasDescription}" Opacity="0.55"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="已添加" Margin="8,0,0,0" FontSize="11"
                             VerticalAlignment="Center" IsVisible="{Binding IsAdded}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{Binding SuggestionSummary}" FontSize="11" Opacity="0.55" Margin="8,2,8,4" />
        </StackPanel>
      </Border>
    </Popup>
  </Panel>
</UserControl>
