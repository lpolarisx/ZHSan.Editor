<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZHSan.Editor.Desktop.ViewModels"
             x:Class="ZHSan.Editor.Desktop.Views.StructuredRuleStringEditorView"
             x:DataType="vm:StructuredRuleStringEditorViewModel">
  <StackPanel Spacing="8">
    <TextBlock Text="{Binding FormatDescription}" FontSize="11" Opacity="0.68"
               TextWrapping="Wrap" />

    <Border Padding="9" CornerRadius="5" Background="#14E5484D"
            IsVisible="{Binding HasIssues}">
      <TextBlock Text="{Binding IssueSummary}" Foreground="#E5484D"
                 FontSize="11" TextWrapping="Wrap" />
    </Border>

    <StackPanel IsEnabled="{Binding CanUseStructuredEditor}" IsVisible="{Binding ShowFlatList}" Spacing="6">
      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StructuredRuleStringEntryViewModel">
            <Border Padding="5" Margin="0,1" CornerRadius="5" BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
              <Grid ColumnDefinitions="Auto,6,*,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Text="{Binding Position, StringFormat='#{0}'}"
                           VerticalAlignment="Center" Opacity="0.6" />

                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding ReferencePicker.FilteredOptions}"
                          SelectedItem="{Binding ReferencePicker.SelectedOption, Mode=TwoWay}"
                          IsVisible="{Binding CanReplaceReference}"
                          MinWidth="100"
                          PlaceholderText="引用目标不存在">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReferenceOptionViewModel">
                      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <Border Grid.Column="2" IsVisible="{Binding ShowReadOnlyReference}"
                        MinWidth="100" Padding="10,5" CornerRadius="3"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                  <TextBlock Text="{Binding ReferenceLabel}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Border>

                <TextBlock Grid.Column="3" Text="!" Margin="5,0,0,0"
                           VerticalAlignment="Center" Foreground="#E5484D"
                           FontWeight="Bold" IsVisible="{Binding IsMissing}"
                           ToolTip.Tip="当前引用无效或目标 ID 重复" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="5,0,0,0"
                            Spacing="4" IsVisible="{Binding ShowWeight}">
                  <TextBlock Text="权重" VerticalAlignment="Center" Opacity="0.65" />
                  <TextBox Width="68"
                           Text="{Binding WeightText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <TextBlock Grid.Column="5" Text="!" Margin="4,0,0,0"
                           VerticalAlignment="Center" Foreground="#E5484D"
                           FontWeight="Bold" IsVisible="{Binding HasWeightError}"
                           ToolTip.Tip="权重必须是有限数字" />

                <Button Grid.Column="6" Content="↑" Command="{Binding MoveUpCommand}"
                        IsVisible="{Binding CanReorder}"
                        Padding="6,2" Margin="4,0,0,0" ToolTip.Tip="上移" />
                <Button Grid.Column="7" Content="↓" Command="{Binding MoveDownCommand}"
                        IsVisible="{Binding CanReorder}"
                        Padding="6,2" Margin="3,0,0,0" ToolTip.Tip="下移" />
                <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="3" Margin="3,0,0,0">
                  <Button Content="定位" Command="{Binding ReferencePicker.NavigateCommand}"
                          Padding="7,2" />
                  <Button Content="×" Command="{Binding RemoveCommand}"
                          Padding="7,2" ToolTip.Tip="移除" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Padding="8" CornerRadius="5" Background="#0AFFFFFF">
        <StackPanel Spacing="5">
          <TextBlock Text="添加一项" FontWeight="SemiBold" />
          <ContentControl Content="{Binding AddPicker}" />
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel IsEnabled="{Binding CanUseStructuredEditor}"
                IsVisible="{Binding ShowWeightedTable}" Spacing="6">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="条件权重" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="复制选中" Click="OnCopyWeightedClick"
                Padding="7,2" Margin="4,0,0,0" ToolTip.Tip="Ctrl+C" />
        <Button Grid.Column="2" Content="粘贴多行" Click="OnPasteWeightedClick"
                Padding="7,2" Margin="4,0,0,0" ToolTip.Tip="Ctrl+V" />
      </Grid>

      <DataGrid x:Name="WeightedConditionsGrid"
                ItemsSource="{Binding Entries}"
                SelectedItem="{Binding SelectedWeightedEntry, Mode=TwoWay}"
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"
                CanUserSortColumns="False"
                GridLinesVisibility="All"
                HeadersVisibility="Column"
                SelectionMode="Extended"
                MinHeight="80" MaxHeight="280"
                RowHeight="34"
                KeyDown="OnWeightedGridKeyDown">
        <DataGrid.Columns>
          <DataGridTextColumn Header="#" Binding="{Binding Position}"
                              Width="42" IsReadOnly="True" />
          <DataGridTemplateColumn Header="条件" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:StructuredRuleStringEntryViewModel">
                <Grid ColumnDefinitions="*,Auto">
                  <ComboBox ItemsSource="{Binding ReferencePicker.FilteredOptions}"
                            SelectedItem="{Binding ReferencePicker.SelectedOption, Mode=TwoWay}"
                            MinWidth="100" PlaceholderText="引用目标不存在">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ReferenceOptionViewModel">
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Column="1" Text="!" Margin="5,0,0,0"
                             VerticalAlignment="Center" Foreground="#E5484D"
                             FontWeight="Bold" IsVisible="{Binding IsMissing}"
                             ToolTip.Tip="当前条件引用无效或目标 ID 重复" />
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="权重" Width="90">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:StructuredRuleStringEntryViewModel">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Text="{Binding WeightText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           HorizontalContentAlignment="Right" />
                  <TextBlock Grid.Column="1" Text="!" Margin="4,0,0,0"
                             VerticalAlignment="Center" Foreground="#E5484D"
                             FontWeight="Bold" IsVisible="{Binding HasWeightError}"
                             ToolTip.Tip="权重必须是有限数字" />
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="操作" Width="146">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:StructuredRuleStringEntryViewModel">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <Button Content="↑" Command="{Binding MoveUpCommand}"
                          Padding="6,2" ToolTip.Tip="上移（Alt+↑）" />
                  <Button Content="↓" Command="{Binding MoveDownCommand}"
                          Padding="6,2" ToolTip.Tip="下移（Alt+↓）" />
                  <Button Content="定位" Command="{Binding ReferencePicker.NavigateCommand}"
                          Padding="7,2" />
                  <Button Content="×" Command="{Binding RemoveCommand}"
                          Padding="7,2" ToolTip.Tip="删除（Delete）" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Text="可从 Excel 粘贴两列数据（条件 ID、权重）；快捷键：Ctrl+C/V、Delete、Alt+↑/↓。"
                 FontSize="11" Opacity="0.58" TextWrapping="Wrap" />
      <Border Padding="8" CornerRadius="5" Background="#14E5484D"
              IsVisible="{Binding HasPasteIssues}">
        <TextBlock Text="{Binding PasteIssueSummary}" Foreground="#E5484D"
                   FontSize="11" TextWrapping="Wrap" />
      </Border>

      <Border Padding="8" CornerRadius="5" Background="#0AFFFFFF">
        <StackPanel Spacing="5">
          <TextBlock Text="添加条件（默认权重 1）" FontWeight="SemiBold" />
          <ContentControl Content="{Binding AddPicker}" />
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel IsEnabled="{Binding CanUseStructuredEditor}"
                IsVisible="{Binding IsConditionExpression}" Spacing="8">
      <ItemsControl ItemsSource="{Binding ConditionGroups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ConditionExpressionGroupViewModel">
            <Border Padding="8" Margin="0,2" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                  <TextBlock Text="{Binding Heading}" FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="↑" Command="{Binding MoveUpCommand}"
                          Padding="6,2" Margin="4,0,0,0" ToolTip.Tip="上移整个或分组" />
                  <Button Grid.Column="2" Content="↓" Command="{Binding MoveDownCommand}"
                          Padding="6,2" Margin="3,0,0,0" ToolTip.Tip="下移整个或分组" />
                  <Button Grid.Column="3" Content="删除组" Command="{Binding RemoveCommand}"
                          Padding="7,2" Margin="3,0,0,0" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Terms}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConditionExpressionTermViewModel">
                      <Grid ColumnDefinitions="Auto,Auto,6,*,Auto,Auto,Auto,Auto,Auto"
                            Margin="0,1">
                        <TextBlock Text="{Binding Position, StringFormat='#{0}'}"
                                   VerticalAlignment="Center" Opacity="0.55" />
                        <CheckBox Grid.Column="1" Content="非"
                                  IsChecked="{Binding IsNegated, Mode=TwoWay}"
                                  Margin="7,0,0,0" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="3"
                                  ItemsSource="{Binding ReferencePicker.FilteredOptions}"
                                  SelectedItem="{Binding ReferencePicker.SelectedOption, Mode=TwoWay}"
                                  MinWidth="100" PlaceholderText="引用目标不存在">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReferenceOptionViewModel">
                              <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Column="4" Text="!" Margin="5,0,0,0"
                                   VerticalAlignment="Center" Foreground="#E5484D"
                                   FontWeight="Bold" IsVisible="{Binding IsMissing}"
                                   ToolTip.Tip="当前条件引用无效或目标 ID 重复" />
                        <Button Grid.Column="5" Content="↑" Command="{Binding MoveUpCommand}"
                                Padding="6,2" Margin="4,0,0,0" ToolTip.Tip="在组内上移" />
                        <Button Grid.Column="6" Content="↓" Command="{Binding MoveDownCommand}"
                                Padding="6,2" Margin="3,0,0,0" ToolTip.Tip="在组内下移" />
                        <Button Grid.Column="7" Content="定位"
                                Command="{Binding ReferencePicker.NavigateCommand}"
                                Padding="7,2" Margin="3,0,0,0" />
                        <Button Grid.Column="8" Content="×" Command="{Binding RemoveCommand}"
                                Padding="7,2" Margin="3,0,0,0" ToolTip.Tip="移除条件" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Padding="8" CornerRadius="5" Background="#0AFFFFFF">
        <StackPanel Spacing="6">
          <TextBlock Text="添加条件" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="Auto,8,*,Auto">
            <TextBlock Text="添加到" VerticalAlignment="Center" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding ConditionGroups}"
                      SelectedItem="{Binding SelectedAddGroup, Mode=TwoWay}"
                      IsEnabled="{Binding HasConditionGroups}"
                      MinWidth="100" PlaceholderText="首个分组">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ConditionExpressionGroupViewModel">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <CheckBox Grid.Column="3" Content="新建“或”分组"
                      IsChecked="{Binding AddAsAlternativeGroup, Mode=TwoWay}"
                      IsEnabled="{Binding HasConditionGroups}"
                      Margin="10,0,0,0" VerticalAlignment="Center" />
          </Grid>
          <ContentControl Content="{Binding AddPicker}" />
        </StackPanel>
      </Border>
    </StackPanel>

    <Grid ColumnDefinitions="*,Auto,Auto">
      <Button Content="{Binding RawEditorToggleText}"
              Command="{Binding ToggleRawEditorCommand}"
              IsVisible="{Binding CanToggleRawEditor}"
              Padding="7,2" FontSize="11" />
      <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="11" Opacity="0.58"
                 VerticalAlignment="Center" Margin="8,0" />
    </Grid>
    <StackPanel IsVisible="{Binding ShowRawEditor}" Spacing="4">
      <TextBlock Text="底层格式（仅用于修复无法解析的内容）" FontSize="11" Opacity="0.58" />
      <TextBox Text="{Binding RawText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               AcceptsReturn="True" MinHeight="52" TextWrapping="Wrap" />
    </StackPanel>
  </StackPanel>
</UserControl>
