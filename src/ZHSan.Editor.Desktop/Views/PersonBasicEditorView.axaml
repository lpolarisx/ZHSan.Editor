<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editors="using:ZHSan.Editor.Desktop.Editors"
             xmlns:views="using:ZHSan.Editor.Desktop.Views"
             x:Class="ZHSan.Editor.Desktop.Views.PersonBasicEditorView"
             x:DataType="editors:PersonBasicEditorViewModel">
  <UserControl.Styles>
    <Style Selector="NumericUpDown.compact">
      <Setter Property="ShowButtonSpinner" Value="False" />
      <Setter Property="Increment" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
      <Setter Property="views:IntegerInput.IsEnabled" Value="True" />
    </Style>
    <Style Selector="NumericUpDown.out-of-range">
      <Setter Property="BorderBrush" Value="#E5534B" />
    </Style>
    <Style Selector="NumericUpDown.invalid-input">
      <Setter Property="BorderBrush" Value="#E5534B" />
      <Setter Property="ToolTip.Tip" Value="只能输入整数，离开输入框后会恢复原值" />
    </Style>
    <!-- Fields sit in 268px cells: 64px right-aligned label, 8px gap, 100px or 180px input. -->
    <Style Selector="TextBlock.field-label">
      <Setter Property="Width" Value="64" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="TextBlock.warning">
      <Setter Property="Foreground" Value="#E5534B" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.portrait">
      <Setter Property="Padding" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="#30343D" />
      <Setter Property="BorderBrush" Value="#59606C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,2,2,2" />
    </Style>
    <Style Selector="Button.chip-remove">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="ToggleButton.skill-toggle">
      <Setter Property="Background" Value="#30343D" />
      <Setter Property="Foreground" Value="#C9CDD5" />
      <Setter Property="BorderBrush" Value="#59606C" />
    </Style>
    <Style Selector="ToggleButton.skill-toggle:checked">
      <Setter Property="Background" Value="#1769AA" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#4BA6EB" />
    </Style>
  </UserControl.Styles>
  <UserControl.DataTemplates>
    <DataTemplate x:DataType="editors:PersonFieldGroupViewModel">
      <Border Padding="14" CornerRadius="7" BorderThickness="1"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="12"
                       Opacity="0.65" VerticalAlignment="Center"
                       Classes.warning="{Binding IsWarning}" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Fields}" Margin="0,0,0,-10">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemWidth="268" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="editors:PersonBasicFieldViewModel">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Spacing="8">
                  <TextBlock Text="{Binding Label}" Classes="field-label" />
                  <Panel Width="{Binding InputWidth}">
                    <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             IsVisible="{Binding IsText}" />
                    <NumericUpDown Value="{Binding NumericValue, Mode=TwoWay}"
                                   Classes="compact" IsVisible="{Binding IsNumber}"
                                   Classes.out-of-range="{Binding IsOutOfRange}"
                                   ToolTip.Tip="{Binding RangeTip}" />
                    <ComboBox ItemsSource="{Binding Options}"
                              SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                              IsVisible="{Binding IsEnum}" HorizontalAlignment="Stretch" />
                    <ComboBox ItemsSource="{Binding ChoiceOptions}"
                              SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                              IsVisible="{Binding IsChoice}" HorizontalAlignment="Stretch" />
                    <TextBox Text="{Binding IdListText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             PlaceholderText="ID，空格分隔" IsVisible="{Binding IsIdList}" />
                    <ComboBox ItemsSource="{Binding SexOptions}"
                              SelectedItem="{Binding SelectedSex, Mode=TwoWay}"
                              IsVisible="{Binding IsSex}" HorizontalAlignment="Stretch" />
                    <CheckBox IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                              IsVisible="{Binding IsBoolean}" />
                  </Panel>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:DataType="editors:PersonIdChipListViewModel">
      <Grid ColumnDefinitions="64,*" ColumnSpacing="8">
        <TextBlock Text="{Binding Label}" Classes="field-label"
                   VerticalAlignment="Top" Margin="0,6,0,0" />
        <StackPanel Grid.Column="1" Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ComboBox ItemsSource="{Binding Candidates}"
                      SelectedItem="{Binding Candidate, Mode=TwoWay}"
                      PlaceholderText="选择要添加的项" IsEnabled="{Binding CanEdit}" Width="240">
              <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ComboBox.ItemsPanel>
            </ComboBox>
            <Button Content="添加" Command="{Binding AddCommand}" />
          </StackPanel>
          <TextBlock Text="无" Opacity="0.5" FontSize="12" IsVisible="{Binding IsEmpty}" />
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="editors:PersonIdChipViewModel">
                <Border Classes="chip" Margin="0,0,6,6">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                    <Button Classes="chip-remove" Content="×" Command="{Binding RemoveCommand}"
                            ToolTip.Tip="移除" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Foreground="#D9534F"
                     IsVisible="{Binding !CanEdit}" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>
  <Grid ColumnDefinitions="220,1,*" Background="#08000000">
    <Grid RowDefinitions="Auto,Auto,*" Margin="10">
      <TextBlock Text="人物" FontSize="18" FontWeight="SemiBold" Margin="5,4,0,8" />
      <TextBox Grid.Row="1" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="搜索姓名或 ID" Margin="0,0,0,6" />
      <ListBox Grid.Row="2" ItemsSource="{Binding FilteredPeople}"
               SelectedItem="{Binding SelectedPerson, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="editors:PersonOptionViewModel">
            <TextBlock Text="{Binding Label}" Margin="5,4" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <Border Grid.Column="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    <Grid Grid.Column="2" RowDefinitions="Auto,*">
      <Border Padding="17,11" BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding SelectedTitle}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SelectedId}" Opacity="0.58" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding CountText}" Opacity="0.58"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>
      <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
        <TabItem Header="基本">
          <ScrollViewer>
        <StackPanel Margin="16" Spacing="13">
          <TextBlock Text="选择左侧人物，编辑基本属性。修改会进入撤销记录，使用主窗口的保存按钮写入文件。"
                     TextWrapping="Wrap" Opacity="0.6" FontSize="12" />
          <TextBlock Text="当前没有人物记录。" IsVisible="{Binding !HasSelection}" />
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13" IsVisible="{Binding HasSelection}">
            <!-- Stretches to the identity card's height so both bottoms line up. -->
            <Button Classes="portrait" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Click="OnPortraitClick" ToolTip.Tip="{Binding PortraitTip}">
              <Grid RowDefinitions="*,Auto" RowSpacing="8">
                <Border Width="160" MinHeight="140" CornerRadius="5" ClipToBounds="True"
                        Background="{DynamicResource SystemControlForegroundBaseLowBrush}">
                  <Panel>
                    <Image Source="{Binding Portrait}" Stretch="UniformToFill" IsVisible="{Binding HasPortrait}" />
                    <StackPanel IsVisible="{Binding !HasPortrait}" Spacing="6"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Path Data="M24,4 A10,10 0 1 1 23.99,4 Z M4,46 C4,32 14,27 24,27 C34,27 44,32 44,46 Z"
                            Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            Width="48" Height="46" Stretch="Uniform" HorizontalAlignment="Center" Opacity="0.6" />
                      <TextBlock Text="{Binding PortraitHint}" FontSize="12" Opacity="0.7"
                                 TextAlignment="Center" TextWrapping="Wrap" MaxWidth="140" />
                    </StackPanel>
                  </Panel>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding PortraitFileName}" FontSize="12" Opacity="0.6"
                           HorizontalAlignment="Center" />
              </Grid>
            </Button>
            <ContentControl Grid.Column="1" Content="{Binding IdentityGroup}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding LeadingGroups}" IsVisible="{Binding HasSelection}" />
          <Border Padding="14" CornerRadius="7" BorderThickness="1"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="10">
              <TextBlock Text="能力" FontSize="16" FontWeight="SemiBold" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="*" MaxWidth="564" />
                </Grid.ColumnDefinitions>
                <Grid RowDefinitions="18,32,32" RowSpacing="8">
                  <TextBlock Grid.Row="1" Text="能力" Classes="field-label" />
                  <TextBlock Grid.Row="2" Text="经验" Classes="field-label" />
                </Grid>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding AbilityColumns}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Rows="1" ColumnSpacing="16" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="editors:PersonAbilityColumnViewModel">
                      <Grid RowDefinitions="18,32,32" RowSpacing="8">
                        <TextBlock Text="{Binding Label}" FontSize="12" Opacity="0.72"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                        <NumericUpDown Grid.Row="1" Value="{Binding Ability.NumericValue, Mode=TwoWay}"
                                       Classes="compact" Classes.out-of-range="{Binding Ability.IsOutOfRange}"
                                       ToolTip.Tip="{Binding Ability.RangeTip}" />
                        <NumericUpDown Grid.Row="2" Value="{Binding Experience.NumericValue, Mode=TwoWay}"
                                       Classes="compact" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding TrailingGroups}" IsVisible="{Binding HasSelection}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="13" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <Border Padding="14" CornerRadius="7" BorderThickness="1"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="10">
              <TextBlock Text="亲属与人际" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{Binding FamilyStatus}" TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
              <ItemsControl ItemsSource="{Binding FamilyReferenceFields}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel ItemWidth="268" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="editors:PersonReferenceFieldViewModel">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Spacing="8">
                      <TextBlock Text="{Binding Label}" Classes="field-label" />
                      <ComboBox ItemsSource="{Binding Options}"
                                SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                IsEnabled="{Binding CanEdit}" Width="180">
                        <ComboBox.ItemsPanel>
                          <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                          </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                      </ComboBox>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding FamilyListFields}" Margin="0,0,0,-10">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel ItemWidth="268" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="editors:PersonIdListFieldViewModel">
                    <Grid ColumnDefinitions="64,180" ColumnSpacing="8" Margin="0,0,0,10">
                      <TextBlock Text="{Binding Label}" Classes="field-label"
                                 VerticalAlignment="Top" Margin="0,6,0,0" />
                    <StackPanel Grid.Column="1" Spacing="6">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <ComboBox ItemsSource="{Binding Candidates}"
                                  SelectedItem="{Binding Candidate, Mode=TwoWay}"
                                  PlaceholderText="选择人物" IsEnabled="{Binding CanEdit}"
                                  HorizontalAlignment="Stretch">
                          <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                              <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                          </ComboBox.ItemsPanel>
                        </ComboBox>
                        <Button Grid.Column="1" Content="添加" Command="{Binding AddCommand}" />
                      </Grid>
                      <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                               Height="150" />
                      <Button Content="删除" Command="{Binding RemoveCommand}" />
                      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Foreground="#D9534F"
                                 IsVisible="{Binding !CanEdit}" />
                    </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Padding="14" CornerRadius="7" BorderThickness="1"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="列传信息" FontSize="16" FontWeight="SemiBold" />
                <Button Grid.Column="1" Content="新建列传"
                        Command="{Binding AddBiographyCommand}"
                        IsVisible="{Binding CanAddBiography}" />
              </Grid>
              <TextBlock Text="{Binding BiographyStatus}" TextWrapping="Wrap"
                         FontSize="12" Opacity="0.65" />
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasBiography}">
                <TextBlock Text="势力颜色" Classes="field-label" />
                <ComboBox ItemsSource="{Binding FactionColorOptions}"
                          SelectedItem="{Binding SelectedFactionColor, Mode=TwoWay}" Width="180">
                  <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ComboBox.ItemsPanel>
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="editors:PersonColorOption">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="28" Height="14" CornerRadius="2" Background="{Binding Swatch}"
                                BorderThickness="1" BorderBrush="#80FFFFFF" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <ContentControl Content="{Binding BiographyMilitaryKinds}" IsVisible="{Binding HasBiography}" />
              <ItemsControl ItemsSource="{Binding BiographyFields}" Margin="0,0,0,-10"
                            IsVisible="{Binding HasBiography}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="editors:BiographyTextFieldViewModel">
                    <Grid ColumnDefinitions="64,*" ColumnSpacing="8" Margin="0,0,0,10">
                      <TextBlock Text="{Binding Label}" Classes="field-label"
                                 VerticalAlignment="Top" Margin="0,6,0,0" />
                      <TextBox Grid.Column="1" Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               AcceptsReturn="True" TextWrapping="Wrap"
                               VerticalContentAlignment="Top" MinHeight="100" MaxHeight="240" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="技能与称号">
          <ScrollViewer>
            <StackPanel Margin="16" Spacing="13">
              <TextBlock Text="技能点击按钮切换；称号按种类选择；专属称号与兵种从下拉框添加、点 × 移除。人物仅保存战法经验，具体战法在部队的“当前战法／自动战法”中设置。修改可撤销并随人物配置保存。"
                         TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
              <TextBlock Text="当前没有人物记录。" IsVisible="{Binding !HasSelection}" />
              <Border Padding="14" CornerRadius="7" BorderThickness="1"
                      BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                      IsVisible="{Binding HasSelection}">
                <StackPanel Spacing="10">
                  <TextBlock Text="技能" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SkillStatus}" TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
                  <ItemsControl ItemsSource="{Binding SkillButtons}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="112" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="editors:PersonSkillButtonViewModel">
                        <ToggleButton Classes="skill-toggle" Content="{Binding Name}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      IsEnabled="{Binding CanToggle}"
                                      Margin="0,0,8,8" MinHeight="34" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Padding="14" CornerRadius="7" BorderThickness="1"
                      BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                      IsVisible="{Binding HasSelection}">
                <StackPanel Spacing="10">
                  <TextBlock Text="称号" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding TitleStatus}" TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
                  <ItemsControl ItemsSource="{Binding TitleSlots}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="268" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="editors:PersonTitleSlotViewModel">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Spacing="8">
                          <TextBlock Text="{Binding KindName}" Classes="field-label" />
                          <ComboBox ItemsSource="{Binding Options}"
                                    SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                    IsEnabled="{Binding CanEdit}" Width="180">
                            <ComboBox.ItemsPanel>
                              <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                              </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                          </ComboBox>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,0,0,4" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding StudyingTitleField.Label}" Classes="field-label" />
                    <ComboBox ItemsSource="{Binding StudyingTitleField.ChoiceOptions}"
                              SelectedItem="{Binding StudyingTitleField.SelectedChoice, Mode=TwoWay}" Width="300">
                      <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                      </ComboBox.ItemsPanel>
                    </ComboBox>
                    <TextBlock Text="正在学习、尚未获得的称号" FontSize="12" Opacity="0.55" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Padding="14" CornerRadius="7" BorderThickness="1"
                      BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                      IsVisible="{Binding HasSelection}">
                <StackPanel Spacing="10">
                  <TextBlock Text="专属称号与兵种" FontSize="16" FontWeight="SemiBold" />
                  <ItemsControl ItemsSource="{Binding ExclusiveLists}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <ContentControl Content="{Binding ExperienceGroup}" IsVisible="{Binding HasSelection}" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="人物对话">
          <ScrollViewer>
            <StackPanel Margin="16" Spacing="13" DataContext="{Binding Messages}"
                        x:DataType="editors:PersonMessagesViewModel">
              <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding CanEdit}">
                <ComboBox ItemsSource="{Binding AvailableKinds}" SelectedItem="{Binding NewKind, Mode=TwoWay}"
                          PlaceholderText="选择要添加的对话类型" Width="280">
                  <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ComboBox.ItemsPanel>
                </ComboBox>
                <Button Content="添加对话类型" Command="{Binding AddKindCommand}" />
              </StackPanel>
              <TextBlock Text="这名人物还没有专属对话，游戏会使用默认文本。" Opacity="0.55" FontSize="12"
                         IsVisible="{Binding IsEmpty}" />
              <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="13" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="editors:PersonMessageGroupViewModel">
                    <Border Padding="14" CornerRadius="7" BorderThickness="1"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding KindLabel}" FontSize="15" FontWeight="SemiBold"
                                     VerticalAlignment="Center" />
                          <Button Grid.Column="1" Content="删除此类型" Command="{Binding RemoveCommand}" />
                        </Grid>
                        <TextBlock Text="暂无台词" Opacity="0.5" FontSize="12" IsVisible="{Binding IsEmpty}" />
                        <ItemsControl ItemsSource="{Binding Lines}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="editors:PersonMessageLineViewModel">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         PlaceholderText="清空后离开输入框即删除这句" TextWrapping="Wrap" />
                                <Button Grid.Column="1" Classes="chip-remove" Content="×"
                                        Command="{Binding RemoveCommand}" ToolTip.Tip="删除这句" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                          <TextBox Text="{Binding NewLine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   PlaceholderText="输入新台词" TextWrapping="Wrap" />
                          <Button Grid.Column="1" Content="添加台词" Command="{Binding AddLineCommand}" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</UserControl>
