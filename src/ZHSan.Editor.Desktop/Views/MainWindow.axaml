<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZHSan.Editor.Desktop.ViewModels"
        xmlns:domain="using:ZHSan.Editor.Domain.Configuration"
        x:Class="ZHSan.Editor.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ZHSan 游戏配置编辑器"
        Width="1480" Height="900"
        MinWidth="1100" MinHeight="680"
        DataContextChanged="OnDataContextChanged"
        KeyDown="OnWindowKeyDown">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenArchiveCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseProjectCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAllCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding SelectedDocument.UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding SelectedDocument.RedoCommand}" />
    <KeyBinding Gesture="Ctrl+X" Command="{Binding SelectedDocument.CutCommand}" />
    <KeyBinding Gesture="Ctrl+C" Command="{Binding SelectedDocument.CopyToClipboardCommand}" />
    <KeyBinding Gesture="Ctrl+V" Command="{Binding SelectedDocument.PasteCommand}" />
    <KeyBinding Gesture="Insert" Command="{Binding SelectedDocument.AddCommand}" />
    <KeyBinding Gesture="Ctrl+D" Command="{Binding SelectedDocument.CopyCommand}" />
    <KeyBinding Gesture="Ctrl+Delete" Command="{Binding SelectedDocument.DeleteCommand}" />
    <KeyBinding Gesture="F8" Command="{Binding ValidateCommand}" />
    <KeyBinding Gesture="Ctrl+I" Command="{Binding ImportJsonCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+I" Command="{Binding ImportArchiveCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportJsonCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+E" Command="{Binding ExportProjectDirectoryCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding PublishCommand}" />
  </Window.KeyBindings>
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="文件">
        <MenuItem Header="打开数据档案…" Command="{Binding OpenArchiveCommand}" InputGesture="Ctrl+O" />
        <MenuItem Header="关闭项目" Command="{Binding CloseProjectCommand}" InputGesture="Ctrl+W" />
        <Separator />
        <MenuItem Header="保存当前配置" Command="{Binding SaveDocumentCommand}" InputGesture="Ctrl+S" />
        <MenuItem Header="全部保存" Command="{Binding SaveAllCommand}" InputGesture="Ctrl+Shift+S" />
        <Separator />
        <MenuItem Header="另存为…" Command="{Binding SaveAsCommand}" />
        <MenuItem Header="保存副本…" Command="{Binding SaveCopyCommand}" />
      </MenuItem>
      <MenuItem Header="编辑">
        <MenuItem Header="{Binding SelectedDocument.UndoLabel}" Command="{Binding SelectedDocument.UndoCommand}" InputGesture="Ctrl+Z" />
        <MenuItem Header="{Binding SelectedDocument.RedoLabel}" Command="{Binding SelectedDocument.RedoCommand}" InputGesture="Ctrl+Y" />
        <Separator />
        <MenuItem Header="剪切记录" Command="{Binding SelectedDocument.CutCommand}" InputGesture="Ctrl+X" />
        <MenuItem Header="复制记录" Command="{Binding SelectedDocument.CopyToClipboardCommand}" InputGesture="Ctrl+C" />
        <MenuItem Header="粘贴记录" Command="{Binding SelectedDocument.PasteCommand}" InputGesture="Ctrl+V" />
        <Separator />
        <MenuItem Header="新增记录" Command="{Binding SelectedDocument.AddCommand}" InputGesture="Insert" />
        <MenuItem Header="创建记录副本" Command="{Binding SelectedDocument.CopyCommand}" InputGesture="Ctrl+D" />
        <MenuItem Header="删除记录" Command="{Binding SelectedDocument.DeleteCommand}" InputGesture="Ctrl+Delete" />
      </MenuItem>
      <MenuItem Header="数据">
        <MenuItem Header="导入当前配置 JSON…" Command="{Binding ImportJsonCommand}" InputGesture="Ctrl+I" />
        <MenuItem Header="从数据档案批量导入…" Command="{Binding ImportArchiveCommand}" InputGesture="Ctrl+Shift+I" />
        <Separator />
        <MenuItem Header="导出当前配置 JSON…" Command="{Binding ExportJsonCommand}" InputGesture="Ctrl+E" />
        <MenuItem Header="导出全项目到目录…" Command="{Binding ExportProjectDirectoryCommand}" InputGesture="Ctrl+Shift+E" />
        <Separator />
        <MenuItem Header="发布游戏配置包…" Command="{Binding PublishCommand}" InputGesture="Ctrl+Shift+P" />
        <Separator />
        <MenuItem Header="校验项目" Command="{Binding ValidateCommand}" InputGesture="F8" />
      </MenuItem>
      <MenuItem Header="视图">
        <MenuItem Header="配置导航侧栏"
                  ToggleType="CheckBox"
                  IsChecked="{Binding IsNavigationPaneVisible, Mode=TwoWay}" />
        <MenuItem Header="属性详情侧栏"
                  ToggleType="CheckBox"
                  IsChecked="{Binding IsDetailsPaneVisible, Mode=TwoWay}" />
      </MenuItem>
      <MenuItem Header="工具">
        <MenuItem Header="关闭项目前确认未保存内容"
                  ToggleType="CheckBox"
                  IsChecked="{Binding ConfirmUnsavedChanges, Mode=TwoWay}" />
      </MenuItem>
      <MenuItem Header="帮助" />
    </Menu>

    <Border DockPanel.Dock="Top" Padding="14,10" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,16,Auto,6,Auto,16,*,Auto">
        <Button Grid.Column="0" Content="打开数据档案" Command="{Binding OpenArchiveCommand}" />
        <Button Grid.Column="2" Content="保存" Command="{Binding SaveDocumentCommand}" />
        <Button Grid.Column="4" Content="撤销" Command="{Binding SelectedDocument.UndoCommand}" />
        <Button Grid.Column="6" Content="重做" Command="{Binding SelectedDocument.RedoCommand}" />
        <Button Grid.Column="8" Content="校验" Command="{Binding ValidateCommand}" />
        <ToggleButton Grid.Column="10" Content="导航栏"
                      IsChecked="{Binding IsNavigationPaneVisible, Mode=TwoWay}"
                      ToolTip.Tip="显示或隐藏左侧配置导航" />
        <ToggleButton Grid.Column="12" Content="属性栏"
                      IsChecked="{Binding IsDetailsPaneVisible, Mode=TwoWay}"
                      ToolTip.Tip="显示或隐藏右侧属性详情" />
        <StackPanel Grid.Column="14" VerticalAlignment="Center">
          <TextBlock Text="{Binding ProjectTitle}" FontWeight="SemiBold" />
          <TextBlock Text="GameDataArchive · CommonData.dat" FontSize="12" Opacity="0.58" />
        </StackPanel>
        <TextBlock Grid.Column="15" Text="NET 9 · Avalonia" VerticalAlignment="Center" Opacity="0.58" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Padding="14,10" Background="#FFF4CE"
            IsVisible="{Binding HasExternalChange}">
      <Grid ColumnDefinitions="Auto,*,Auto,8,Auto">
        <TextBlock Text="!" FontSize="18" FontWeight="Bold" Foreground="#7A4D00"
                   VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Grid.Column="1" Text="{Binding ExternalChangeMessage}" Foreground="#5C3A00"
                   TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="2" Content="另存为…" Command="{Binding SaveAsCommand}" />
        <Button Grid.Column="4" Content="关闭提示" Command="{Binding DismissExternalChangeCommand}" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="14,7" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusText}" />
        <TextBlock Grid.Column="1" Text="{Binding SelectedDocument.SelectionSummary}" Opacity="0.62" />
      </Grid>
    </Border>

    <Grid>
      <Grid x:Name="MainWorkspaceGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="250" MinWidth="180" MaxWidth="520" />
          <ColumnDefinition Width="5" />
          <ColumnDefinition Width="*" MinWidth="400" />
          <ColumnDefinition Width="5" />
          <ColumnDefinition Width="380" MinWidth="280" MaxWidth="720" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderThickness="0,0,1,0"
                IsVisible="{Binding IsNavigationPaneVisible}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Margin="14,14,14,10" Spacing="3">
              <TextBlock Text="配置导航" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="按游戏数据分类" FontSize="12" Opacity="0.58" />
            </StackPanel>
            <ScrollViewer Grid.Row="1">
              <ItemsControl ItemsSource="{Binding Categories}" Margin="8,0,8,12">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConfigCategoryViewModel">
                    <Expander Header="{Binding Name}" IsExpanded="True" Margin="0,2">
                      <ItemsControl ItemsSource="{Binding Documents}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ConfigDocumentViewModel">
                            <Button Command="{Binding SelectCommand}" HorizontalContentAlignment="Stretch"
                                    Padding="10,7" Margin="4,1">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding DisplayLabel}" />
                                <Border Grid.Column="1" CornerRadius="8" Padding="7,1" Background="#223B82F6">
                                  <TextBlock Text="{Binding ItemCount}" FontSize="11" />
                                </Border>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      IsVisible="{Binding IsNavigationPaneVisible}"
                      Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                      Cursor="SizeWestEast"
                      ToolTip.Tip="拖动调整配置导航宽度" />

        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
          <Border Padding="18,13" BorderThickness="0,0,0,1"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Grid ColumnDefinitions="*,Auto,12,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding SelectedDocumentTitle}" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedDocumentSummary}" Opacity="0.62" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                          IsVisible="{Binding SelectedDocument.HasSpecializedEditor}">
                <Button Content="专用编辑"
                        Command="{Binding SelectedDocument.ShowSpecializedEditorCommand}"
                        IsEnabled="{Binding SelectedDocument.IsGenericEditorActive}" />
                <Button Content="表格编辑"
                        Command="{Binding SelectedDocument.ShowGenericEditorCommand}"
                        IsEnabled="{Binding SelectedDocument.IsSpecializedEditorActive}" />
              </StackPanel>
              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                          IsVisible="{Binding HasSelectedDocument}">
                <Button Content="导入 JSON" Command="{Binding ImportJsonCommand}" />
                <Button Content="新增" Command="{Binding SelectedDocument.AddCommand}" />
                <Button Content="创建副本" Command="{Binding SelectedDocument.CopyCommand}" />
                <Button Content="粘贴" Command="{Binding SelectedDocument.PasteCommand}" />
                <Button Content="删除" Command="{Binding SelectedDocument.DeleteCommand}" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="1" Padding="12,9" BorderThickness="0,0,0,1"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  IsVisible="{Binding SelectedDocument.IsGenericEditorActive}">
            <Grid ColumnDefinitions="Auto,140,8,*,8,Auto">
              <TextBlock Text="筛选" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding SelectedDocument.FilterFields}"
                        SelectedItem="{Binding SelectedDocument.SelectedFilterField, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConfigFilterFieldViewModel">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBox Grid.Column="3" PlaceholderText="搜索当前配置…"
                       x:Name="CurrentSearchBox"
                       Text="{Binding SelectedDocument.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="5" Content="清除" Command="{Binding SelectedDocument.ClearSearchCommand}" />
            </Grid>
          </Border>

          <Grid Grid.Row="2">
            <DataGrid x:Name="RecordsGrid"
                      ItemsSource="{Binding SelectedDocument.FilteredRecords}"
                      SelectedItem="{Binding SelectedDocument.SelectedRecord, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Extended"
                      SelectionChanged="RecordsGrid_OnSelectionChanged"
                      IsVisible="{Binding SelectedDocument.IsGenericEditorActive}" />

            <ContentControl Content="{Binding SelectedDocument.SpecializedEditor.Content}"
                            IsVisible="{Binding SelectedDocument.IsSpecializedEditorActive}" />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Width="520"
                        IsVisible="{Binding HasNoProject}">
              <Border Width="72" Height="72" CornerRadius="18" Background="#263B82F6">
                <TextBlock Text="数" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="#6EA8FE" />
              </Border>
              <TextBlock Text="打开数据档案开始编辑" FontSize="18" FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock Text="选择 CommonData.dat 后，可在此搜索、排序、多选和管理配置记录。"
                         TextWrapping="Wrap" TextAlignment="Center" Opacity="0.62" />
              <Button Content="打开数据档案…" Command="{Binding OpenArchiveCommand}"
                      HorizontalAlignment="Center" />
              <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0"
                    IsVisible="{Binding HasRecentProjects}">
                <TextBlock Text="最近打开" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="清除" Command="{Binding ClearRecentProjectsCommand}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding RecentProjects}"
                            IsVisible="{Binding HasRecentProjects}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RecentProjectViewModel">
                    <Button Command="{Binding OpenCommand}" HorizontalContentAlignment="Stretch"
                            Padding="12,8" Margin="0,2">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding DirectoryName}" FontSize="11" Opacity="0.58"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="打开" VerticalAlignment="Center" Opacity="0.65" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </Grid>

        <GridSplitter Grid.Column="3"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      IsVisible="{Binding IsDetailsPaneVisible}"
                      Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                      Cursor="SizeWestEast"
                      ToolTip.Tip="拖动调整属性详情宽度" />

        <Border Grid.Column="4" BorderThickness="1,0,0,0"
                IsVisible="{Binding IsDetailsPaneVisible}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <TabControl x:Name="DetailsTabs"
                      SelectedIndex="{Binding SelectedDetailsTabIndex, Mode=TwoWay}"
                      IsVisible="{Binding HasSelectedDocument}">
            <TabItem Header="属性">
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding SelectedDocument.PropertyEditors}" Margin="12">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PropertyEditorViewModel">
                      <Border Padding="10" Margin="0,0,0,8" CornerRadius="5" Background="#0DFFFFFF">
                        <StackPanel Spacing="6">
                          <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="校验定位" FontSize="11"
                                       Foreground="#E5484D" FontWeight="SemiBold"
                                       IsVisible="{Binding IsValidationTarget}" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="2" Text="{Binding TypeName}" FontSize="11" Opacity="0.55" />
                          </Grid>

                          <TextBox Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   IsVisible="{Binding ShowString}" />
                          <ContentControl Content="{Binding StructuredStringEditor}"
                                          IsVisible="{Binding ShowStructuredString}" />
                          <NumericUpDown Value="{Binding NumericValue, Mode=TwoWay}"
                                         Increment="1" IsVisible="{Binding ShowNumber}" />
                          <ContentControl Content="{Binding ReferencePicker}"
                                          IsVisible="{Binding ShowReference}" />
                          <CheckBox IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                    Content="启用" IsVisible="{Binding ShowBoolean}" />
                          <ComboBox ItemsSource="{Binding Options}"
                                    SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                    IsVisible="{Binding ShowEnum}" />

                          <StackPanel IsVisible="{Binding ShowCollection}" Spacing="5">
                            <ItemsControl ItemsSource="{Binding CollectionItems}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CollectionItemViewModel">
                                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <TextBox Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsVisible="{Binding ShowText}" />
                                    <ContentControl Content="{Binding ReferencePicker}"
                                                    IsVisible="{Binding ShowReference}" />
                                    <Button Grid.Column="1" Content="移除" Command="{Binding RemoveCommand}" Margin="5,0,0,0" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="添加一项" Command="{Binding AddCollectionItemCommand}"
                                    HorizontalAlignment="Left" />
                          </StackPanel>

                          <TextBox Text="{Binding ReadOnlyValue}" IsReadOnly="True"
                                   IsVisible="{Binding IsReadOnly}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding ValidationTabHeader}">
              <Grid RowDefinitions="Auto,Auto,*" Margin="12">
                <Grid ColumnDefinitions="150,8,*">
                  <ComboBox ItemsSource="{Binding ValidationSeverityFilters}"
                            SelectedItem="{Binding SelectedValidationSeverityFilter, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ValidationSeverityFilterViewModel">
                        <TextBlock Text="{Binding DisplayName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBox Grid.Column="2"
                           Text="{Binding ValidationSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           PlaceholderText="筛选配置、ID、字段或消息…" />
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding ValidationSummary}"
                           Margin="2,10,2,8" Opacity="0.68" TextWrapping="Wrap" />
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding ValidationIssues}"
                         DoubleTapped="ValidationIssues_OnDoubleTapped">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ValidationIssueViewModel">
                      <Border Padding="10,8" Margin="0,1" CornerRadius="4" Background="#0DFFFFFF">
                        <StackPanel Spacing="4">
                          <Grid ColumnDefinitions="Auto,8,*">
                            <Border Padding="7,2" CornerRadius="8" Background="#26E5484D">
                              <TextBlock Text="{Binding SeverityText}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding Location}"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          </Grid>
                          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Opacity="0.78" />
                          <TextBlock Text="双击定位" FontSize="10" Opacity="0.42"
                                     HorizontalAlignment="Right" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </TabItem>

            <TabItem Header="全局搜索">
              <Grid RowDefinitions="Auto,Auto,*" Margin="12">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBox Text="{Binding GlobalSearchText, Mode=TwoWay}"
                           x:Name="GlobalSearchBox"
                           PlaceholderText="搜索全部配置字段…" />
                  <Button Grid.Column="1" Content="搜索" Command="{Binding GlobalSearchCommand}"
                          Margin="6,0,0,0" />
                  <Button Grid.Column="2" Content="清除" Command="{Binding ClearGlobalSearchCommand}"
                          Margin="6,0,0,0" />
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding GlobalSearchSummary}"
                           Margin="2,10,2,8" Opacity="0.62" />
                <ListBox Grid.Row="2" ItemsSource="{Binding GlobalSearchResults}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GlobalSearchResultViewModel">
                      <Button Command="{Binding NavigateCommand}"
                              HorizontalContentAlignment="Stretch"
                              Padding="10,8" Margin="0,1">
                        <StackPanel Spacing="3">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding DocumentName}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding FieldName}"
                                       FontSize="11" Opacity="0.58" />
                          </Grid>
                          <TextBlock Text="{Binding ValuePreview}"
                                     TextWrapping="Wrap" MaxLines="2" Opacity="0.78" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </TabItem>

            <TabItem Header="{Binding ImportTabHeader}" IsVisible="{Binding HasImportPreview}">
              <Grid RowDefinitions="Auto,Auto,Auto,150,Auto,*,Auto" Margin="12">
                <TextBlock Text="导入前预览" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Text="{Binding ImportPreviewSummary}"
                           Margin="0,5,0,10" TextWrapping="Wrap" Opacity="0.72" />
                <StackPanel Grid.Row="2" Spacing="5">
                  <TextBlock Text="合并策略" FontWeight="SemiBold" />
                  <ComboBox ItemsSource="{Binding ImportStrategies}"
                            SelectedItem="{Binding SelectedImportStrategy, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ImportStrategyOptionViewModel">
                        <TextBlock Text="{Binding DisplayName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{Binding ImportStrategyDescription}"
                             TextWrapping="Wrap" FontSize="11" Opacity="0.62" />
                </StackPanel>
                <ListBox Grid.Row="3" ItemsSource="{Binding ImportPreviewDocuments}" Margin="0,10,0,8">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ImportPreviewDocumentViewModel">
                      <Border Padding="9,7" Margin="0,1" CornerRadius="4" Background="#0DFFFFFF">
                        <StackPanel Spacing="3">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding StrategyText}" FontSize="11" Opacity="0.6" />
                          </Grid>
                          <TextBlock Text="{Binding Summary}" FontSize="11" />
                          <TextBlock Text="{Binding ResultText}" FontSize="11" TextWrapping="Wrap" Opacity="0.65" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Expander Grid.Row="4" Header="读取失败详情" IsVisible="{Binding HasImportFailures}"
                          IsExpanded="True" Margin="0,0,0,8">
                  <ItemsControl ItemsSource="{Binding ImportFailures}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ImportFailureViewModel">
                        <StackPanel Margin="7,4" Spacing="2">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11" Foreground="#E5484D" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
                <ListBox Grid.Row="5" ItemsSource="{Binding ImportDifferenceRows}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ImportDifferenceRowViewModel">
                      <Border Padding="8,6" Margin="0,1" CornerRadius="4" Background="#0DFFFFFF">
                        <StackPanel Spacing="3">
                          <Grid ColumnDefinitions="Auto,8,*,Auto">
                            <TextBlock Text="{Binding ChangeKind}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{Binding ConfigName}" />
                            <TextBlock Grid.Column="3" Text="{Binding RecordLabel}" Opacity="0.62" />
                          </Grid>
                          <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11" Opacity="0.72" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                  <Button Content="应用可用更改" Command="{Binding ApplyImportCommand}" />
                  <Button Content="取消" Command="{Binding CancelImportPreviewCommand}" />
                </StackPanel>
              </Grid>
            </TabItem>

            <TabItem Header="批量修改" IsVisible="{Binding SelectedDocument.HasMultipleSelection}">
              <StackPanel Margin="16" Spacing="10">
                <TextBlock Text="{Binding SelectedDocument.SelectionSummary}"
                           FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="为当前选中的全部记录设置同一个字段值。整次操作可一次撤销。"
                           TextWrapping="Wrap" Opacity="0.62" />
                <TextBlock Text="字段" Margin="0,8,0,0" />
                <ComboBox ItemsSource="{Binding SelectedDocument.BatchEditFields}"
                          SelectedItem="{Binding SelectedDocument.SelectedBatchField, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:BatchEditFieldViewModel">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="新值" />
                <TextBox Text="{Binding SelectedDocument.BatchValueText, Mode=TwoWay}"
                         PlaceholderText="输入文本、数字、布尔值或枚举名称" />
                <Button Content="应用到所选记录"
                        Command="{Binding SelectedDocument.ApplyBatchEditCommand}"
                        HorizontalAlignment="Left" />
              </StackPanel>
            </TabItem>

            <TabItem Header="原始 JSON">
              <TextBox Text="{Binding SelectedDocument.RawJson}"
                       IsReadOnly="True" AcceptsReturn="True"
                       TextWrapping="NoWrap" FontFamily="Consolas, Cascadia Mono, monospace"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       Margin="8" />
            </TabItem>

            <TabItem Header="{Binding ImportLogTabHeader}">
              <Grid RowDefinitions="Auto,*" Margin="12">
                <TextBlock Text="导入/导出/发布日志与失败详情" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListBox Grid.Row="1" ItemsSource="{Binding ImportLogEntries}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ImportLogEntryViewModel">
                      <Border Padding="9,7" Margin="0,1" CornerRadius="4" Background="#0DFFFFFF">
                        <StackPanel Spacing="3">
                          <Grid ColumnDefinitions="Auto,8,Auto,8,*,Auto">
                            <TextBlock Text="{Binding Operation}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{Binding Status}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="{Binding TargetName}" />
                            <TextBlock Grid.Column="5" Text="{Binding TimeText}" FontSize="10" Opacity="0.55" />
                          </Grid>
                          <TextBlock Text="{Binding SourceName}" FontSize="11" Opacity="0.55" />
                          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11" Opacity="0.75" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </TabItem>
          </TabControl>
        </Border>
      </Grid>

      <Border Background="#D9222222" IsVisible="{Binding IsBusy}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
          <ProgressBar IsIndeterminate="True" Width="260" />
          <TextBlock Text="正在加载数据档案…" FontSize="16" />
        </StackPanel>
      </Border>

      <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="20"
              Background="#E5484D" CornerRadius="6" Padding="14,9"
              IsVisible="{Binding HasError}">
        <TextBlock Text="{Binding ErrorMessage}" Foreground="White" TextWrapping="Wrap" MaxWidth="760" />
      </Border>
    </Grid>
  </DockPanel>
</Window>
