<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editors="using:ZHSan.Editor.Desktop.Editors"
             xmlns:views="using:ZHSan.Editor.Desktop.Views"
             x:Class="ZHSan.Editor.Desktop.Views.FactionColorEditorView"
             x:DataType="editors:FactionColorEditorViewModel">
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="14" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>
    <Style Selector="Border.swatch">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#59606C" />
    </Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="220,1,*" Background="#08000000">
    <Grid RowDefinitions="Auto,Auto,*" Margin="10">
      <TextBlock Text="势力颜色" FontSize="18" FontWeight="SemiBold" Margin="5,4,0,8" />
      <TextBox Grid.Row="1" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="搜索色值或 ID" Margin="0,0,0,6" />
      <ListBox Grid.Row="2" ItemsSource="{Binding FilteredRecords}"
               SelectedItem="{Binding SelectedRecord, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="editors:RecordOptionViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="5,3">
              <Border Classes="swatch" Width="28" Height="18"
                      Background="{Binding Name, Converter={x:Static views:HexColorBrushConverter.Instance}}" />
              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <Border Grid.Column="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    <Grid Grid.Column="2" RowDefinitions="Auto,*">
      <Border Padding="17,11" BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding SelectedTitle}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SelectedId}" Opacity="0.58" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding CountText}" Opacity="0.58" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1">
        <StackPanel Margin="16" Spacing="13">
          <TextBlock Text="势力和列传按位置引用颜色，ID 即位置。在下方选好颜色后点“应用”写入，修改会进入撤销记录，使用主窗口的保存按钮写入文件。"
                     TextWrapping="Wrap" Opacity="0.6" FontSize="12" />
          <TextBlock Text="当前没有记录。" IsVisible="{Binding !HasSelection}" />
          <Border Classes="card" IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Text="当前" FontSize="12" Opacity="0.6" />
                  <Border Classes="swatch" Width="72" Height="40" Background="{Binding StoredBrush}" />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="新颜色" FontSize="12" Opacity="0.6" />
                  <Border Classes="swatch" Width="72" Height="40">
                    <Border.Background>
                      <SolidColorBrush Color="{Binding DraftColor}" />
                    </Border.Background>
                  </Border>
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom" Spacing="6">
                  <TextBlock Text="{Binding DraftText}" Opacity="0.8" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="应用" Command="{Binding ApplyCommand}" Classes="accent" />
                    <Button Content="还原" Command="{Binding ResetCommand}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
              <ColorView Color="{Binding DraftColor, Mode=TwoWay}" HorizontalAlignment="Left"
                         IsAlphaEnabled="True" IsColorPaletteVisible="True" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
