<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editors="using:ZHSan.Editor.Desktop.Editors"
             xmlns:views="using:ZHSan.Editor.Desktop.Views"
             x:Class="ZHSan.Editor.Desktop.Views.FactionEditorView"
             x:DataType="editors:FactionEditorViewModel">
  <UserControl.Styles>
    <Style Selector="NumericUpDown.compact">
      <Setter Property="ShowButtonSpinner" Value="False" />
      <Setter Property="Increment" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
      <Setter Property="views:IntegerInput.IsEnabled" Value="True" />
    </Style>
    <Style Selector="NumericUpDown.invalid-input">
      <Setter Property="BorderBrush" Value="#E5534B" />
      <Setter Property="ToolTip.Tip" Value="只能输入整数，离开输入框后会恢复原值" />
    </Style>
    <!-- Same grid as the person editor: 268px cells, 64px right-aligned label, 8px gap, 100px or 180px input. -->
    <Style Selector="TextBlock.field-label">
      <Setter Property="Width" Value="64" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="14" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>
    <Style Selector="ToggleButton.skill-toggle">
      <Setter Property="Background" Value="#30343D" />
      <Setter Property="Foreground" Value="#C9CDD5" />
      <Setter Property="BorderBrush" Value="#59606C" />
    </Style>
    <Style Selector="ToggleButton.skill-toggle:checked">
      <Setter Property="Background" Value="#1769AA" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#4BA6EB" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="#30343D" />
      <Setter Property="BorderBrush" Value="#59606C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,2,2,2" />
    </Style>
    <Style Selector="Button.chip-remove">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="24" />
    </Style>
  </UserControl.Styles>
  <UserControl.DataTemplates>
    <DataTemplate x:DataType="editors:PersonFieldGroupViewModel">
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding Fields}" Margin="0,0,0,-10">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemWidth="268" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="editors:PersonBasicFieldViewModel">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Spacing="8">
                  <TextBlock Text="{Binding Label}" Classes="field-label" />
                  <Panel Width="{Binding InputWidth}">
                    <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             IsVisible="{Binding IsText}" />
                    <NumericUpDown Value="{Binding NumericValue, Mode=TwoWay}"
                                   Classes="compact" IsVisible="{Binding IsNumber}" />
                    <ComboBox ItemsSource="{Binding ChoiceOptions}"
                              SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                              IsVisible="{Binding IsChoice}" HorizontalAlignment="Stretch">
                      <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                      </ComboBox.ItemsPanel>
                    </ComboBox>
                    <CheckBox IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                              IsVisible="{Binding IsBoolean}" />
                  </Panel>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:DataType="editors:PersonIdChipListViewModel">
      <Grid ColumnDefinitions="64,*" ColumnSpacing="8">
        <TextBlock Text="{Binding Label}" Classes="field-label" VerticalAlignment="Top" Margin="0,6,0,0" />
        <StackPanel Grid.Column="1" Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding Candidate, Mode=TwoWay}"
                      PlaceholderText="选择要添加的项" IsEnabled="{Binding CanEdit}" Width="260">
              <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ComboBox.ItemsPanel>
            </ComboBox>
            <Button Content="添加" Command="{Binding AddCommand}" />
          </StackPanel>
          <TextBlock Text="无" Opacity="0.5" FontSize="12" IsVisible="{Binding IsEmpty}" />
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="editors:PersonIdChipViewModel">
                <Border Classes="chip" Margin="0,0,6,6">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                    <Button Classes="chip-remove" Content="×" Command="{Binding RemoveCommand}" ToolTip.Tip="移除" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Foreground="#D9534F"
                     IsVisible="{Binding !CanEdit}" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>
  <Grid ColumnDefinitions="220,1,*" Background="#08000000">
    <Grid RowDefinitions="Auto,Auto,*" Margin="10">
      <TextBlock Text="势力" FontSize="18" FontWeight="SemiBold" Margin="5,4,0,8" />
      <TextBox Grid.Row="1" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="搜索名称或 ID" Margin="0,0,0,6" />
      <ListBox Grid.Row="2" ItemsSource="{Binding FilteredRecords}"
               SelectedItem="{Binding SelectedRecord, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="editors:RecordOptionViewModel">
            <TextBlock Text="{Binding Label}" Margin="5,4" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <Border Grid.Column="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    <Grid Grid.Column="2" RowDefinitions="Auto,*">
      <Border Padding="17,11" BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="18" Height="18" CornerRadius="3" Background="{Binding ColorSwatch}"
                    BorderThickness="1" BorderBrush="#80FFFFFF" VerticalAlignment="Center"
                    IsVisible="{Binding HasSelection}" />
            <TextBlock Text="{Binding SelectedTitle}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SelectedId}" Opacity="0.58" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding CountText}" Opacity="0.58" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1">
        <StackPanel Margin="16" Spacing="13">
          <TextBlock Text="选择左侧势力，编辑属性。修改会进入撤销记录，使用主窗口的保存按钮写入文件。各势力之间的关系在“外交关系”中编辑。"
                     TextWrapping="Wrap" Opacity="0.6" FontSize="12" />
          <TextBlock Text="当前没有势力记录。" IsVisible="{Binding !HasSelection}" />
          <ContentControl Content="{Binding BasicGroup}" IsVisible="{Binding HasSelection}" />
          <Border Classes="card" IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="10">
              <TextBlock Text="势力颜色" FontSize="16" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="颜色" Classes="field-label" />
                <ComboBox ItemsSource="{Binding ColorOptions}"
                          SelectedItem="{Binding SelectedColor, Mode=TwoWay}" Width="180">
                  <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ComboBox.ItemsPanel>
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="editors:PersonColorOption">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="28" Height="14" CornerRadius="2" Background="{Binding Swatch}"
                                BorderThickness="1" BorderBrush="#80FFFFFF" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="取自 CommonData 的势力颜色表" FontSize="12" Opacity="0.55" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding MiddleGroups}" IsVisible="{Binding HasSelection}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="13" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <Border Classes="card" IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="10">
              <TextBlock Text="领地与军事" FontSize="16" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding TerritoryLists}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="12" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="10">
              <TextBlock Text="已研究技巧" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{Binding TechniqueStatus}" TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
              <ItemsControl ItemsSource="{Binding TechniqueButtons}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel ItemWidth="128" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="editors:FactionTechniqueButtonViewModel">
                    <ToggleButton Classes="skill-toggle" Content="{Binding Name}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanToggle}"
                                  ToolTip.Tip="{Binding Tip}" HorizontalAlignment="Stretch"
                                  Margin="0,0,8,8" MinHeight="34" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
