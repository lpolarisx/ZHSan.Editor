<Project>
  <!--
    Publishes the editor as one self-contained exe that runs without .NET installed:
      dotnet publish src/ZHSan.Editor.Desktop -p:PublishProfile=SingleExe
    The exe is written to artifacts/ZHSan.Editor.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Avalonia draws with SkiaSharp and HarfBuzz, whose native DLLs are unpacked from the exe on first start. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Precompiled code: later starts take about 1.7 s instead of 2.4 s, for 69 MB instead of 51 MB. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <!-- Not trimmed: the editor reads and writes the game's data types through reflection. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\ZHSan.Editor\</PublishDir>
  </PropertyGroup>

  <!-- The SkiaSharp and HarfBuzz packages ship debug symbols beside their native DLLs; they are not needed to run. -->
  <Target Name="DropPackageSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
