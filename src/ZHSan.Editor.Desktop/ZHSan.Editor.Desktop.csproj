<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\editor-icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <!-- -p:ReadOnlyConfigs=true builds a version in which the configurations listed in ReadOnlyConfigs.json are view-only. -->
  <PropertyGroup Condition="'$(ReadOnlyConfigs)' == 'true'">
    <DefineConstants>$(DefineConstants);READONLY_CONFIGS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="ReadOnlyConfigs.json" LogicalName="ZHSan.Editor.Desktop.ReadOnlyConfigs.json" />
    <AvaloniaResource Include="Assets\editor-icon.png" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="..\ZHSan.Editor.Application\ZHSan.Editor.Application.csproj" />
    <ProjectReference Include="..\ZHSan.Editor.Infrastructure\ZHSan.Editor.Infrastructure.csproj" />
    <Reference Include="ZHSan.Data">
      <HintPath>..\..\libs\ZHSan.Data.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
